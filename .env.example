WAREHOUSE_DB_RUNTIME_PASSWORD=

# Kafka-only companion Compose file uses six distinct 64-character lowercase hex passwords.
# Generate with a cryptographic RNG, store only in ignored .env; never paste values into chat.
KAFKA_BROKER_PASSWORD=
KAFKA_ADMIN_PASSWORD=
KAFKA_ORDER_PASSWORD=
KAFKA_PAYMENT_PASSWORD=
KAFKA_WAREHOUSE_PASSWORD=
KAFKA_CORE_PASSWORD=
KAFKA_HOST_PORT=19092
